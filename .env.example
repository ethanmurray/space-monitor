ANTHROPIC_API_KEY=sk-ant-...

# Optional — point at a Turso (libSQL) database instead of a local SQLite
# file. When TURSO_DATABASE_URL is set and starts with libsql:// or
# https://, the CLI defaults to using it; otherwise --db PATH (or the
# default ./space_monitor.db) applies.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
