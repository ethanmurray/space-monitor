# Copy to .streamlit/secrets.toml and fill in.
#
# On Streamlit Community Cloud, paste the same contents into the
# "Secrets" textarea in the app settings. Streamlit injects them as
# st.secrets[...] AND as environment variables (which is what we read).
#
# .streamlit/secrets.toml is gitignored. .streamlit/secrets.toml.example
# is committed as a template.

ANTHROPIC_API_KEY     = "sk-ant-..."
TURSO_DATABASE_URL    = "libsql://<your-db>.turso.io"
TURSO_AUTH_TOKEN      = "eyJ..."

# Optional — name attributed to actions in the analyst UI.
ANALYST_NAME          = "your-name"

# Optional — gates the UI behind a shared password. Unset = open.
# UI_PASSWORD         = "pick-something-strong"

# Optional — webhooks for digest / cost-alarm / source-health POSTs.
# NOTIFY_WEBHOOK_URL  = "https://hooks.slack.com/services/..."
# NOTIFY_WEBHOOK_KIND = "slack"   # or "discord"

# Optional — base URL for magic-link approve/reject tokens. When set,
# digest emails contain clickable URLs; otherwise they fall back to a
# `space-monitor review consume <token>` CLI invocation.
# REVIEW_LINK_BASE_URL = "https://your-app.streamlit.app"
